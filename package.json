{
  "name": "@ancircle0/dsh-skills-ext",
  "version": "0.4.0",
  "description": "DSH Harness plugin: keep preset skill directories and link their skills into the user skill root (directory junction on Windows, symlink elsewhere).",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "skills",
    "skill-management",
    "junction",
    "symlink"
  ],
  "license": "MIT",
  "author": "ancircle <ancircle@foxmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ancircle0/dsh-skills-ext.git"
  },
  "homepage": "https://github.com/ancircle0/dsh-skills-ext#readme",
  "bugs": {
    "url": "https://github.com/ancircle0/dsh-skills-ext/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/core.js && node --check lib/service.js",
    "test": "node test/core.test.mjs",
    "verify": "npm run check && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-store": "^0.1.7-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.0 || ^0.2.0-rc.1 || ^0.2.1-rc.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
